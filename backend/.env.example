# ── Local model (Ollama) ─────────────────────────────────────────
# Everything runs on your machine; no code is sent to a cloud AI service.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Context window in tokens. Lower it if your machine runs out of memory.
OLLAMA_NUM_CTX=32768

# ── GitHub (optional) ────────────────────────────────────────────
# Needed to open pull requests and to read private repos.
# - Your own repos only: fine-grained token, Contents + Pull requests read & write.
# - Also other people's public repos (PRs from your fork): classic token, public_repo scope.
GITHUB_TOKEN=

# ── Local folders ────────────────────────────────────────────────
# Comma-separated folders RepoScan may scan. Defaults to your home folder.
# LOCAL_ROOTS=/Users/you/code

# ── Security ─────────────────────────────────────────────────────
# Browser origins allowed to use the API (comma-separated).
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Optional shared secret. If set, also set VITE_API_TOKEN for the frontend.
# REPOSCAN_API_TOKEN=

# ── Limits ───────────────────────────────────────────────────────
# Files reviewed per analysis run.
# MAX_FILES=25
# Larger files are skipped. Raise together with OLLAMA_NUM_CTX (~3-4 chars per token).
# MAX_FILE_CHARS=24000
# Parallel reviews. Only raise if Ollama runs with OLLAMA_NUM_PARALLEL > 1.
# ANALYZE_CONCURRENCY=1
# Chat messages the agent remembers.
# HISTORY_LIMIT=20

# Restart the backend after changing this file. See README > Tuning your setup.
